{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approved": {
      "type": "boolean"
    },
    "repair_stage": {
      "enum": [
        null,
        "decompose",
        "map"
      ]
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "proposition_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "mapped",
              "excluded",
              "missing",
              "unverified"
            ]
          },
          "unit_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "proposition_id",
          "status",
          "unit_id",
          "reason"
        ]
      }
    },
    "additional_propositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reasoning_type": {
            "enum": [
              "factual_finding",
              "legal_condition",
              "fact_to_rule_application",
              "legal_consequence"
            ]
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "group_rationale": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "quote"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "unit_id",
          "reasoning",
          "source_ids",
          "reasoning_type",
          "group_id",
          "group_rationale",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "approved",
    "problems"
  ]
}
