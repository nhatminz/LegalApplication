{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reasoning_type": {
            "enum": [
              "factual_finding",
              "legal_condition",
              "fact_to_rule_application",
              "legal_consequence"
            ]
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "group_rationale": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "quote"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "unit_id",
          "reasoning",
          "source_ids"
        ]
      },
      "minItems": 0
    },
    "non_reasoning": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "reason"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "units",
    "non_reasoning"
  ]
}
