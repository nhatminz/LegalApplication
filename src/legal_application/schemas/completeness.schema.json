{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["doc_name", "classification_status", "data_status", "reason", "issues_analysis"],
  "properties": {
    "doc_name": {"type": "string", "minLength": 1},
    "classification_status": {"enum": ["completed", "unclassifiable"]},
    "data_status": {"enum": ["full", "partial", null]},
    "reason": {"type": "string", "minLength": 1},
    "issues_analysis": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue_index", "original_issue", "decisive_facts", "explanation"],
        "properties": {
          "issue_index": {"type": "integer", "minimum": 1},
          "original_issue": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "decisive_facts": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["fact", "availability", "decisive", "reference_evidence", "facts_clean_evidence", "raw_facts_evidence", "explanation"],
              "properties": {
                "fact": {"type": "string", "minLength": 1},
                "availability": {"enum": ["present", "reasonably_inferred", "missing"]},
                "decisive": {"type": "boolean"},
                "explanation": {"type": "string", "minLength": 1},
                "reference_evidence": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["source", "quote"],
                    "properties": {
                      "source": {"enum": ["application", "conclusion"]},
                      "quote": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "facts_clean_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "raw_facts_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
