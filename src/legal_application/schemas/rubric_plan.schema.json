{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "added_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "issue_text",
          "reason",
          "unit_ids"
        ]
      },
      "minItems": 0
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "issue_index": {
            "type": "integer",
            "minimum": 1
          },
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "other_group_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "relevant_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "rule_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 0
          },
          "missing_information": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "review_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "decisive": {
            "type": "boolean"
          }
        },
        "required": [
          "unit_id",
          "issue_index",
          "group_id",
          "other_group_name",
          "criterion",
          "relevant_fact_ids",
          "rule_indices",
          "missing_information",
          "review_reason",
          "decisive"
        ]
      },
      "minItems": 0
    },
    "excluded_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "exclusion_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "unit_id",
          "exclusion_reason"
        ]
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_index": {
            "type": "integer",
            "minimum": 1
          },
          "reference_verdict": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "outcome_review_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "issue_review_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "issue_index",
          "reference_verdict",
          "verdict_source_ids",
          "outcome_review_reason",
          "issue_review_reason"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "added_issues",
    "assignments",
    "excluded_units",
    "issues"
  ]
}
